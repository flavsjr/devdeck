# Copie para .env e preencha com os dados do seu projeto Supabase (Project Settings → API).
# A chave anon/publishable é pública por design: a segurança vem das policies RLS em supabase/migrations.
# NUNCA coloque a service_role key aqui.
RENDERER_VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
RENDERER_VITE_SUPABASE_KEY=sb_publishable_ou_anon_key
