{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    }
  },
  "include": ["tests/**/*", "scripts/check-tag.mts", "scripts/release-notes.mts", "src/main/lib/**/*", "src/main/gitcore.ts", "src/renderer/src/lib/**/*", "src/shared/**/*", "vitest.config.mts"]
}
